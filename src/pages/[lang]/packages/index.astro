---
/** The catalog of the libraries and npm packages of Didactika. */
import MIcon from '../../../components/MIcon.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Landing from '../../../layouts/Landing.astro';
import {productsOf, site, t} from '../../../lib/site';

export function getStaticPaths() {
    return site().languages.map((language) => ({params: {lang: language.code}}));
}

const {lang} = Astro.params as {lang: string};
const packages = productsOf('package');
---

<Landing lang={lang} title={`${t(lang, 'packages')} · Didactika Docs`} description={t(lang, 'packagesDescription')}>
    <section class="d-section">
        <div class="d-wrap">
            <nav class="d-eyebrow" aria-label="Breadcrumb">
                <a href={`/${lang}/`}>{t(lang, 'home')}</a>
                <MIcon name="chevron-right-rounded" />
                <span>{t(lang, 'packages')}</span>
            </nav>
            <h2 style="margin-top:0.6rem;font-size:2.4rem">{t(lang, 'packages')}</h2>
            <p>{t(lang, 'packagesDescription')}</p>
            {
                packages.length > 0 ? (
                    <div class="d-grid">
                        {packages.map((product) => <ProductCard lang={lang} product={product} />)}
                    </div>
                ) : (
                    <div class="d-empty">
                        <span class="d-tile soft"><MIcon name="deployed-code-rounded" /></span>
                        <div>
                            <h3>{t(lang, 'packagesEmptyTitle')}</h3>
                            <p>{t(lang, 'packagesEmptyText')}</p>
                        </div>
                    </div>
                )
            }
        </div>
    </section>
</Landing>
