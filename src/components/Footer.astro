---
/**
 * The foot of a page of the documentation: the previous and next pages as cards, the link to edit the page and the licence.
 * The pages follow the navigation of the version (see Sidebar.astro).
 */
import MIcon from './MIcon.astro';
import {t} from '../lib/site';

const route = Astro.locals.starlightRoute;
const lang = route.lang;
const {prev, next} = route.pagination;
const editUrl = route.editUrl;
---

<footer class="d-pagefoot">
    {
        (prev || next) && (
            <nav class="d-pager" aria-label="Pagination">
                {prev ? (
                    <a class="d-pager-link" href={prev.href} rel="prev">
                        <span class="d-pager-dir"><MIcon name="arrow-back-rounded" /> {t(lang, 'previous')}</span>
                        <b>{prev.label}</b>
                    </a>
                ) : (
                    <span />
                )}
                {next && (
                    <a class="d-pager-link next" href={next.href} rel="next">
                        <span class="d-pager-dir">{t(lang, 'next')} <MIcon name="arrow-forward-rounded" /></span>
                        <b>{next.label}</b>
                    </a>
                )}
            </nav>
        )
    }
    <div class="d-pagefoot-meta">
        {
            editUrl && (
                <a href={editUrl.href}>
                    <MIcon name="edit-rounded" /> {t(lang, 'editPage')}
                </a>
            )
        }
        <span>{t(lang, 'footerLicence')}</span>
    </div>
</footer>
