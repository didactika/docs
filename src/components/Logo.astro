---
/**
 * The mark of Didactika Docs, built as the one of the design system: the book of Didactika on a white tile and
 * a teal pill that says what the site is ("DOC", where the design system says "UI").
 */
interface Props {
    size?: 'sm' | 'lg' | 'xl';
}
const {size = 'sm'} = Astro.props;
---

<span class:list={['d-logo', size !== 'sm' && `is-${size}`]} aria-hidden="true">
    <img src="/brand/didactika-logo.png" alt="" width="64" height="64" />
    <b class="d-logo-tag">DOC</b>
</span>
