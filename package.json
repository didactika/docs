    "test": "node --test \"tools/**/*.test.ts\"",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.10",
    "yaml": "^2.8.0"
