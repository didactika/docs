{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The documentation portal of Didactika: Moodle plugins and npm packages, by version and language.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node tools/sync.ts",
    "dev": "node tools/sync.ts && node tools/project.ts && astro dev",
    "build": "node tools/sync.ts && node tools/project.ts && astro build",
    "preview": "astro preview",
    "serve": "node tools/serve.ts",
    "brand": "node tools/build-brand.ts",
    "test": "node --test \"tools/**/*.test.ts\"",
    "typecheck": "astro sync && tsc --noEmit",
    "icons": "node tools/check-icons.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.98",
    "astro": "^7.4.10",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
